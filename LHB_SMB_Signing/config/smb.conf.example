# EXAMPLE ONLY: replace paths and export actual configuration from the lab.
# Keep the signing policy the same before/after patch to compare enforcement.
[global]
    server role = standalone server
    server min protocol = SMB2_02
    server signing = mandatory
    map to guest = Never

[Confidential_Data]
    path = /srv/samba/Confidential_Data
    valid users = student
    read only = yes
    guest ok = no
